rules_version = '2';

// Security rules for the cloud (Firebase) mode. Paste into Firebase console → Firestore → Rules.
//
//   users/{uid}                        your own profile (and daily AI use) only; deleted with the account
//   trips/{tripId}                     members read; only the owner renames / resizes the trip and
//                                      decides who's in it; members plan together (cities, hotels, flights)
//   trips/{tripId}/requests/{uid}      join requests: you ask for yourself, the owner approves or declines
//   trips/{tripId}/places/{placeId}    members only
//   trips/{tripId}/meta/{docId}        members only (the itinerary lives in meta/plan)
//   trips/{tripId}/messages/{id}       members only; post as yourself; members react and vote (their own
//                                      entry only); no edits or deletes
//   invites/{code}                     fetch by exact code only; never listable
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function tripPath(tripId) {
      return /databases/$(database)/documents/trips/$(tripId);
    }

    // Reads check the stored trip; writes check the trip as it will be after the write
    // (so a batch that creates a trip together with its first documents is allowed).
    function isMember(tripId) {
      return signedIn() && request.auth.uid in get(tripPath(tripId)).data.memberIds;
    }

    function isMemberAfter(tripId) {
      return signedIn() && request.auth.uid in getAfter(tripPath(tripId)).data.memberIds;
    }

    function isOwner(tripId) {
      return signedIn() && get(tripPath(tripId)).data.ownerId == request.auth.uid;
    }

    function shortText(value, max) {
      return value is string && value.size() > 0 && value.size() <= max;
    }

    function validTrip(data) {
      return shortText(data.name, 60)
        && data.startDate is string && data.startDate.size() == 10
        && data.days is int && data.days >= 1 && data.days <= 90
        && data.memberIds is list && data.memberIds.size() <= 20
        && data.flights is list && data.flights.size() <= 20;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['firstName', 'lastName', 'gender', 'updatedAt', 'termsVersion', 'termsAt'])
        && shortText(request.resource.data.firstName, 30)
        && shortText(request.resource.data.lastName, 30)
        && request.resource.data.gender in ['male', 'female', 'other'];
      // Deleting the account.
      allow delete: if signedIn() && request.auth.uid == uid;

      // Daily use of the AI features (a counter per feature per day): only up, never past the caps.
      match /usage/{day} {
        function counter(data, key) {
          return data.get(key, 0);
        }
        function valid(data) {
          return data.keys().hasOnly(['plan', 'rain', 'trip', 'assistant', 'translate', 'entry', 'search'])
            && counter(data, 'plan') is int && counter(data, 'plan') <= 10
            && counter(data, 'rain') is int && counter(data, 'rain') <= 10
            && counter(data, 'trip') is int && counter(data, 'trip') <= 3
            && counter(data, 'assistant') is int && counter(data, 'assistant') <= 30
            && counter(data, 'translate') is int && counter(data, 'translate') <= 20
            && counter(data, 'entry') is int && counter(data, 'entry') <= 40
            && counter(data, 'search') is int && counter(data, 'search') <= 40;
        }
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid && valid(request.resource.data);
        allow update: if signedIn() && request.auth.uid == uid && valid(request.resource.data)
          && counter(request.resource.data, 'plan') >= counter(resource.data, 'plan')
          && counter(request.resource.data, 'rain') >= counter(resource.data, 'rain')
          && counter(request.resource.data, 'trip') >= counter(resource.data, 'trip')
          && counter(request.resource.data, 'assistant') >= counter(resource.data, 'assistant')
          && counter(request.resource.data, 'translate') >= counter(resource.data, 'translate')
          && counter(request.resource.data, 'entry') >= counter(resource.data, 'entry')
          && counter(request.resource.data, 'search') >= counter(resource.data, 'search');
        // Never deleted (that would reset the count); they hold nothing but numbers.
      }
    }

    match /trips/{tripId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && validTrip(request.resource.data);

      allow update: if signedIn() && validTrip(request.resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['inviteCode', 'createdAt'])
        && (
          // The owner edits the trip and decides who's in it (approving requests, removing members),
          // but always stays in it. They may hand the trip over to another member.
          (resource.data.ownerId == request.auth.uid && request.auth.uid in request.resource.data.memberIds
            && request.resource.data.ownerId in request.resource.data.memberIds)
          ||
          // Members plan together (day cities, hotels, flights) but don't rename or resize the trip,
          // and never change who's in it. Joining goes through a request (below), not here.
          (request.auth.uid in resource.data.memberIds
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['name', 'startDate', 'days', 'memberIds', 'members', 'ownerId']))
          ||
          // A member (not the owner) leaves: takes only themselves out.
          (request.auth.uid in resource.data.memberIds
            && resource.data.ownerId != request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'members'])
            && request.resource.data.memberIds == resource.data.memberIds.removeAll([request.auth.uid])
            && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
            && !(request.auth.uid in request.resource.data.members))
          ||
          // A member updates their own entry (name / gender after editing their profile).
          (request.auth.uid in resource.data.memberIds
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
            && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid]))
        );

      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      // Asking to join (with the invite code): only for yourself, while not a member.
      // The owner sees the requests and approves (adds you to memberIds and deletes the request)
      // or declines (marks it declined). You can withdraw your own request.
      match /requests/{uid} {
        function validRequest(data) {
          return data.keys().hasOnly(['name', 'gender', 'at', 'status'])
            && shortText(data.name, 60)
            && data.at is int
            && data.status == 'pending';
        }

        allow get: if signedIn() && (request.auth.uid == uid || isOwner(tripId));
        allow list: if isOwner(tripId);
        allow create: if signedIn() && request.auth.uid == uid
          && !(uid in get(tripPath(tripId)).data.memberIds)
          && validRequest(request.resource.data);
        allow update: if
          (isOwner(tripId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status == 'declined')
          ||
          (signedIn() && request.auth.uid == uid
            && !(uid in get(tripPath(tripId)).data.memberIds)
            && validRequest(request.resource.data));
        allow delete: if signedIn() && (request.auth.uid == uid || isOwner(tripId));
      }

      match /places/{placeId} {
        allow read: if isMember(tripId);
        allow create, update: if isMemberAfter(tripId)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
          && request.resource.data.location.lat is number
          && request.resource.data.location.lng is number;
        allow delete: if isMember(tripId);
      }

      match /meta/{docId} {
        allow read: if isMember(tripId);
        allow write: if isMemberAfter(tripId);
      }

      // Group chat: members read everything and post as themselves. A message is text, or a card
      // (a shared place, a meeting point or a poll) with optional text. Messages are never edited or
      // deleted outright: members add or change their own reaction and poll answer, and an author can
      // take a message back (it stays as "deleted", emptied).
      match /messages/{messageId} {
        function kindOf(data) {
          return data.get('kind', 'text');
        }

        allow read: if isMember(tripId);
        allow create: if isMember(tripId)
          && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'text', 'createdAt', 'kind', 'place', 'meet', 'poll', 'replyTo'])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() > 0 && request.resource.data.authorName.size() <= 40
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          && kindOf(request.resource.data) in ['text', 'place', 'meet', 'poll']
          && (request.resource.data.text.size() > 0 || kindOf(request.resource.data) != 'text')
          && (!('replyTo' in request.resource.data) || request.resource.data.replyTo is map)
          && (kindOf(request.resource.data) != 'place' || request.resource.data.place is map)
          && (kindOf(request.resource.data) != 'meet' || request.resource.data.meet is map)
          && (kindOf(request.resource.data) != 'poll'
            || (request.resource.data.poll is map && request.resource.data.poll.options is list
              && request.resource.data.poll.options.size() >= 2 && request.resource.data.poll.options.size() <= 8))
          && request.resource.data.createdAt is int;
        allow update: if isMember(tripId) && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'votes'])
            && request.resource.data.get('reactions', {}).diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.get('votes', {}).diff(resource.data.get('votes', {})).affectedKeys().hasOnly([request.auth.uid]))
          ||
          // The author deletes their message: only the frame stays, marked deleted, with no content.
          (resource.data.authorId == request.auth.uid
            && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'text', 'createdAt', 'deleted'])
            && request.resource.data.authorId == resource.data.authorId
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.text == ''
            && request.resource.data.deleted == true)
        );
        // Only when the trip's owner deletes the whole trip.
        allow delete: if isOwner(tripId);
      }
    }

    match /invites/{code} {
      // Knowing the exact code lets you ask to join (the owner still approves). Codes are random
      // (32^8) and cannot be listed. The trip and owner names let the asker see what they're joining.
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['tripId', 'tripName', 'ownerName'])
        && request.auth.uid == getAfter(tripPath(request.resource.data.tripId)).data.ownerId;
      // Handing the trip over: the (current) owner updates the name shown on the invite.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerName'])
        && get(tripPath(resource.data.tripId)).data.ownerId == request.auth.uid;
      // The owner deleting the trip also deletes its code.
      allow delete: if signedIn() && (resource == null || get(tripPath(resource.data.tripId)).data.ownerId == request.auth.uid);
    }
  }
}
