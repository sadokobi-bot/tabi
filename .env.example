# Copy this file to .env.local and fill in the values (.env.local is git-ignored).
# Everything is optional: without values the app runs in local mode
# (accounts + data in this browser, free OpenStreetMap map). Full guide: docs/SETUP.md
# For the published site, add the same names as GitHub repository secrets.

# ─── Firebase: accounts + shared trips + real-time sync (free Spark plan, no credit card) ───
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Firebase App Check (reCAPTCHA v3 site key): only this site may use the AI and the data. Optional.
VITE_RECAPTCHA_SITE_KEY=

# ─── Google Maps Platform: Google map + Places search/recommendations (needs a billing account) ───
# Enable "Maps JavaScript API" + "Places API (New)". Restrict the key to your site's URLs and those two APIs.
VITE_GOOGLE_MAPS_API_KEY=
# Map ID (Google Cloud → Map Management, type JavaScript + Vector). Required for custom markers.
VITE_GOOGLE_MAP_ID=
